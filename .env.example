# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Server-only: never use a NEXT_PUBLIC_ prefix and never commit real values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Optional legacy alternative to SUPABASE_SECRET_KEY:
SUPABASE_SERVICE_ROLE_KEY=
# Account ID (not email) that always keeps the Admin role.
ROOT_ADMIN_ID=
