# Database provider. Keep d1 until a Supabase project is provisioned and data is migrated.
DB_PROVIDER=d1
# Server-only Supabase configuration; never use a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
# Legacy service-role JWT supported as an alternative to the secret key:
SUPABASE_SERVICE_ROLE_KEY=
# Exact ID of the explicitly approved existing account. Do not authorize by email alone.
ROOT_ADMIN_ID=
